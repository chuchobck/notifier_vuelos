# Copia este archivo a .env y completa lo que falta. Nunca subas .env a git.
# La tabla completa de variables (obligatoria, ejemplo, qué pasa si falta) está en docs/DEPLOY.md.

# Base de datos. ?schema= elige el esquema (por defecto notificaciones). La de abajo es la del
# docker-compose.yml de este repo (puerto 5434, para no chocar con la del core ni la de identity).
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/notifier_db?schema=notificaciones"
NODE_ENV=development
PORT=3002
# Puerto del host para el PostgreSQL de docker-compose. Si lo cambias, cambia también DATABASE_URL.
DB_PORT=5434
