# Copia este archivo a .env y completa lo que falta. Nunca subas .env a git.
# La tabla completa de variables (obligatoria, ejemplo, qué pasa si falta) está en docs/DEPLOY.md.

# Base de datos. ?schema= elige el esquema (por defecto notificaciones). La de abajo es la del
# docker-compose.yml de este repo (puerto 5434, para no chocar con la del core ni la de identity).
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/notifier_db?schema=notificaciones"
NODE_ENV=development
PORT=3002
# Puerto del host para el PostgreSQL de docker-compose. Si lo cambias, cambia también DATABASE_URL.
DB_PORT=5434

# Clave con la que se cifra el secreto de cada suscripción (AES-256-GCM, derivada con HKDF).
# Obligatoria, de al menos 32 caracteres. Para migrar las suscripciones del core sin que los
# terceros cambien su secreto, tiene que ser la MISMA WEBHOOK_SECRET_KEY del core. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
WEBHOOK_SECRET_KEY=

# Emisor (iss) de los tokens que se aceptan: el JWT_ISSUER de identity_vuelos, un origen sin ruta
# ni barra final (https en producción). Obligatoria. Se compara texto a texto con el "iss".
JWT_ISSUER=http://localhost:3001
# Audiencia (aud) que deben traer los tokens. Obligatoria. identity_vuelos emite quinde-vuelos-api.
JWT_AUDIENCE=quinde-vuelos-api
# De dónde se baja el JWKS. Opcional; sin valor: {JWT_ISSUER}/.well-known/jwks.json.
JWKS_URL=

# Orígenes que pueden llamar al servicio desde un navegador (CORS), separados por coma, sin ruta
# ni barra final y sin "*". Opcional: vacía o ausente, ningún origen de navegador puede llamar.
CORS_ORIGINS=http://localhost:5173
# Límite de peticiones por IP en todo el servicio: máximo por ventana y duración de la ventana en
# segundos. Opcionales; valen 100 y 60. Al pasarse, 429 con Retry-After.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
# Proxies entre el cliente y el servicio, para que la IP del cliente (límites, auditoría) sea la
# de X-Forwarded-For y no la del proxy. false = ninguno (local); 1 = un proxy (un balanceador).
# También acepta una lista de IP, CIDR, loopback, linklocal o uniquelocal. "true" no se acepta.
TRUST_PROXY=false
