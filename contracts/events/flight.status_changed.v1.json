{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/chuchobck/notifier_vuelos/blob/main/contracts/events/flight.status_changed.v1.json",
  "title": "flight.status_changed v1",
  "description": "Cambió el estado operativo de un vuelo (demora, cancelación, cambio de puerta). Un evento por dueño afectado: affectedBookingIds lleva solo sus reservas. Sobre que publica el core en POST /internal/v1/events (schemaVersion 1.x). Solo lo reciben las suscripciones v2 (CloudEvents): no es de los 12 tipos del contrato 1.5.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "ownerId", "data"],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Id del hecho: el mismo para todas las suscripciones que lo reciben y para cada reintento de publicación (idempotencia)."
    },
    "eventType": {
      "type": "string",
      "enum": ["flight.status_changed"],
      "description": "Tipo de evento."
    },
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0", "1.1"],
      "description": "Versión del esquema, mayor.menor. Un menor nuevo agrega solo campos opcionales; un mayor nuevo es otro archivo (<tipo>.v2.json)."
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$",
      "description": "Cuándo pasó el hecho en el core, en UTC (sufijo Z)."
    },
    "ownerId": {
      "type": "string",
      "format": "uuid",
      "description": "Dueño del hecho: el sub del token con que se creó (id_propietario). Solo sus suscripciones lo reciben."
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,100}$",
      "description": "Opcional (desde 1.1, aceptado en cualquier 1.x): el X-Correlation-Id del proceso que originó el hecho, sin cambios. Va al CloudEvent (correlationid) y a la cabecera X-Correlation-Id de cada entrega. Sin él, el notifier usa el X-Correlation-Id de la publicación o genera uno."
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flightNumber", "date", "newStatus"],
      "properties": {
        "flightNumber": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2}[0-9]{1,4}$",
          "description": "Número de vuelo (AV1632)."
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "Fecha de la salida (YYYY-MM-DD)."
        },
        "previousStatus": {
          "type": "string",
          "enum": [
            "SCHEDULED",
            "BOARDING",
            "DEPARTED",
            "DELAYED",
            "ARRIVED",
            "CANCELLED",
            "DIVERTED"
          ],
          "description": "Opcional: el estado anterior (FlightOperationalStatus)."
        },
        "newStatus": {
          "type": "string",
          "enum": [
            "SCHEDULED",
            "BOARDING",
            "DEPARTED",
            "DELAYED",
            "ARRIVED",
            "CANCELLED",
            "DIVERTED"
          ],
          "description": "El estado nuevo (FlightOperationalStatus)."
        },
        "estimatedDepartureAt": {
          "type": ["string", "null"],
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$",
          "description": "Opcional: salida estimada, en UTC."
        },
        "estimatedArrivalAt": {
          "type": ["string", "null"],
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$",
          "description": "Opcional: llegada estimada, en UTC."
        },
        "delayMinutes": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 10000,
          "description": "Opcional: minutos de demora."
        },
        "destination": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "Opcional: aeropuerto de destino (IATA)."
        },
        "affectedBookingIds": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "description": "Opcional: las reservas del dueño en esa salida."
        }
      }
    }
  },
  "examples": [
    {
      "eventId": "5f8d2c1e-7a3b-4e9d-8c6f-000000000015",
      "eventType": "flight.status_changed",
      "schemaVersion": "1.1",
      "occurredAt": "2026-10-23T10:05:12.000Z",
      "ownerId": "0b7c9f4e-3d2a-4b1c-8e5f-6a7b8c9d0e1f",
      "correlationId": "corr-vuelos-7f3a9c",
      "data": {
        "flightNumber": "AV1632",
        "date": "2026-11-20",
        "previousStatus": "SCHEDULED",
        "newStatus": "DELAYED",
        "estimatedDepartureAt": "2026-11-20T15:45:00.000Z",
        "delayMinutes": 45,
        "destination": "GYE",
        "affectedBookingIds": ["7c9e6679-7425-40de-944b-e07fc1f90ae7"]
      }
    }
  ]
}
