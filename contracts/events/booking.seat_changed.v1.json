{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/chuchobck/notifier_vuelos/blob/main/contracts/events/booking.seat_changed.v1.json",
  "title": "booking.seat_changed v1",
  "description": "Se cambió el asiento de un pasajero de la reserva (PUT /vuelos/bookings/{bookingId}/seats). Sobre que publica el core en POST /internal/v1/events (schemaVersion 1.x). Solo lo reciben las suscripciones v2 (CloudEvents): no es de los 12 tipos del contrato 1.5.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "ownerId", "data"],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Id del hecho: el mismo para todas las suscripciones que lo reciben y para cada reintento de publicación (idempotencia)."
    },
    "eventType": {
      "type": "string",
      "enum": ["booking.seat_changed"],
      "description": "Tipo de evento."
    },
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0", "1.1"],
      "description": "Versión del esquema, mayor.menor. Un menor nuevo agrega solo campos opcionales; un mayor nuevo es otro archivo (<tipo>.v2.json)."
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$",
      "description": "Cuándo pasó el hecho en el core, en UTC (sufijo Z)."
    },
    "ownerId": {
      "type": "string",
      "format": "uuid",
      "description": "Dueño del hecho: el sub del token con que se creó (id_propietario). Solo sus suscripciones lo reciben."
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,100}$",
      "description": "Opcional (desde 1.1, aceptado en cualquier 1.x): el X-Correlation-Id del proceso que originó el hecho, sin cambios. Va al CloudEvent (correlationid) y a la cabecera X-Correlation-Id de cada entrega. Sin él, el notifier usa el X-Correlation-Id de la publicación o genera uno."
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bookingId", "pnr", "status"],
      "properties": {
        "bookingId": {
          "type": "string",
          "format": "uuid",
          "description": "Id de la reserva (bookingId del contrato)."
        },
        "pnr": {
          "type": "string",
          "pattern": "^[A-Z0-9]{6}$",
          "description": "Localizador de la reserva."
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "PENDING_PAYMENT",
            "TICKET_ISSUING",
            "CONFIRMED",
            "FAILED",
            "CHANGE_PENDING",
            "CANCELLATION_PENDING",
            "CANCELLED"
          ],
          "description": "Estado de la reserva (BookingDetail.status) en el momento del evento, no el de ahora."
        },
        "ownerId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:@|-]{1,100}$",
          "description": "Opcional (1.1): el usuario final de la reserva (X-User-Id de Booking) o, sin él, el dueño. BookingEventData.ownerId del contrato v2."
        },
        "partnerOrderId": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9._:-]{1,100}$",
          "description": "Opcional (1.1): la orden del partner (Booking) a la que pertenece la reserva."
        },
        "packageId": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9._:-]{1,100}$",
          "description": "Opcional (1.1): el paquete (combo) de Booking del que forma parte."
        },
        "grandTotal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["currency", "total"],
          "description": "Opcional (1.1): el total de la reserva (MoneyAmount del contrato v2).",
          "properties": {
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "description": "Moneda ISO 4217 (USD)."
            },
            "baseFare": {
              "type": "string",
              "pattern": "^[0-9]{1,9}\\.[0-9]{2}$",
              "description": "Tarifa base en texto decimal."
            },
            "taxes": {
              "type": "string",
              "pattern": "^[0-9]{1,9}\\.[0-9]{2}$",
              "description": "Impuestos en texto decimal."
            },
            "total": {
              "type": "string",
              "pattern": "^[0-9]{1,9}\\.[0-9]{2}$",
              "description": "Total en texto decimal (\"239.00\")."
            }
          }
        },
        "changeType": {
          "type": "string",
          "enum": ["DATE_CHANGE", "BAGGAGE", "SEAT"],
          "description": "Opcional (1.1): qué cambió."
        },
        "amountCharged": {
          "type": "object",
          "additionalProperties": false,
          "required": ["currency", "total"],
          "description": "Opcional (1.1): lo cobrado por el cambio (lo cobra Booking).",
          "properties": {
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "description": "Moneda ISO 4217 (USD)."
            },
            "baseFare": {
              "type": "string",
              "pattern": "^[0-9]{1,9}\\.[0-9]{2}$",
              "description": "Tarifa base en texto decimal."
            },
            "taxes": {
              "type": "string",
              "pattern": "^[0-9]{1,9}\\.[0-9]{2}$",
              "description": "Impuestos en texto decimal."
            },
            "total": {
              "type": "string",
              "pattern": "^[0-9]{1,9}\\.[0-9]{2}$",
              "description": "Total en texto decimal (\"239.00\")."
            }
          }
        },
        "paymentReference": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9_.:-]{8,64}$",
          "description": "Opcional (1.1): la referencia del pago del cambio (paymentReference de Booking)."
        }
      }
    }
  },
  "examples": [
    {
      "eventId": "5f8d2c1e-7a3b-4e9d-8c6f-000000000013",
      "eventType": "booking.seat_changed",
      "schemaVersion": "1.1",
      "occurredAt": "2026-10-23T10:05:12.000Z",
      "ownerId": "0b7c9f4e-3d2a-4b1c-8e5f-6a7b8c9d0e1f",
      "correlationId": "corr-vuelos-7f3a9c",
      "data": {
        "bookingId": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
        "pnr": "XK7P2Q",
        "status": "CONFIRMED",
        "changeType": "SEAT",
        "amountCharged": {
          "currency": "USD",
          "total": "15.00"
        },
        "paymentReference": "PAY-BKP-20261023-000982"
      }
    }
  ]
}
