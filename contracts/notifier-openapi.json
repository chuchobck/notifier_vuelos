      "WebhookV2Dto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "url": {
            "type": "string",
            "example": "https://partner.example.com/hooks/vuelos",
            "format": "uri"
          },
          "events": {
            "type": "array",
            "items": {
