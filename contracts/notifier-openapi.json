    "/internal/v1/events": {
      "post": {
        "operationId": "EventoController_publicar",
        "summary": "Publicar un evento",
        "description": "Solo el core, con un token de cliente OAuth (client_credentials) con events:publish. El sobre se valida contra contracts/events/<tipo>.v<mayor>.json; en una transacción se guarda y se crea una entrega por cada suscripción activa del ownerId que escucha el tipo. Idempotente por eventId. Reglas y data por tipo: docs/EVENTOS.md.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SobreEventoDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "El eventId ya se había publicado con el mismo contenido: no se duplicó nada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventoAceptadoDto"
                }
              }
            }
          },
          "202": {
            "description": "Primera vez: el evento y sus entregas ya están guardados (después del commit)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventoAceptadoDto"
                }
              }
            }
          },
          "400": {
            "description": "El sobre no cumple el esquema de su tipo y versión",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Falta el token, no es válido o venció",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "El token no trae los scopes requeridos: events:publish",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "El eventId ya se había publicado con otro contenido",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "eventType o schemaVersion desconocidos",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Más de EVENTS_RATE_LIMIT_MAX publicaciones por minuto desde la misma IP",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "No hay claves del servicio de identidad con las que verificar el token (AUTH_UNAVAILABLE)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "tags": [
          "Eventos internos"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v2/vuelos/eventos": {
      "get": {
        "operationId": "listOutboxEvents",
        "summary": "Feed de eventos CloudEvents (respaldo de los webhooks)",
        "description": "Los eventos del dueño del token en orden de llegada, como CloudEvents (los mismos de la entrega v2). Paginación por cursor: `after` = el id del último leído; `limit` de 1 a 100 (20 por defecto). Un `after` desconocido o de otro dueño es 400.",
        "parameters": [
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "after",
            "required": false,
            "in": "query",
            "description": "Id del último evento ya procesado (el `id` de su CloudEvent, o `metadata.next_after`): devuelve los que llegaron después",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "type",
            "required": false,
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/VuelosEventName"
            }
          },
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "description": "Id del proceso de negocio; se devuelve sin cambios (si falta, se genera)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de eventos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedEventosDto"
                }
              }
            }
          },
          "400": {
            "description": "limit, after o type inválidos (VALIDATION_FAILED)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsV2"
                }
              }
            }
          },
          "401": {
            "description": "Falta el token, no es válido o venció (UNAUTHORIZED)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsV2"
                }
              }
            }
          },
          "403": {
            "description": "Al token le falta el scope (FORBIDDEN)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsV2"
                }
              }
            }
          },
          "429": {
            "description": "Se pasó del límite de peticiones por IP (RATE_LIMIT_EXCEEDED)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsV2"
                }
              }
            }
          },
          "503": {
            "description": "No hay claves del servicio de identidad con las que verificar el token (PROVIDER_UNAVAILABLE)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsV2"
                }
              }
            }
          }
        },
        "tags": [
          "MS.Vuelos — Telemetría (v2)"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "info": {
    "title": "Quinde · Notifier",
    "description": "Suscripciones a webhooks y entrega firmada de los eventos del sistema de vuelos Quinde. Verifica los tokens RS256 de identity_vuelos por su JWKS.",
    "version": "0.2.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Webhooks",
      "description": "Suscripciones a webhooks del usuario del token, idénticas a /webhooks del contrato GDS Flight Core API 1.5.0.0 (scope flights:webhooks)."
    },
    {
      "name": "MS.Clientes — Webhooks (v2)",
      "description": "Suscripciones del contrato de Vuelos v2 (/api/v2/vuelos/webhooks, scope flights:webhooks): las mismas reglas que v1, los 15 VuelosEventName y la entrega en CloudEvents 1.0."
    },
    {
      "name": "MS.Vuelos — Telemetría (v2)",
      "description": "Feed de eventos del contrato de Vuelos v2 (GET /api/v2/vuelos/eventos, scope flights:read): los CloudEvents del dueño del token, respaldo de los webhooks."
    },
    {
      "name": "Eventos internos",
      "description": "Por donde el core publica sus eventos (scope events:publish, solo clientes OAuth). Contrato del sobre: contracts/events/ y contracts/asyncapi.yaml."
    },
    {
      "name": "Salud",
      "description": "Chequeo de vida y de disponibilidad."
    }
