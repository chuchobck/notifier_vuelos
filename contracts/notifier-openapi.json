          }
        ],
        "responses": {
          "204": {
            "description": "Eliminado"
          },
          "400": {
            "description": "id no es un uuid",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Falta el token, no es válido o venció",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "El token no trae los scopes requeridos: flights:webhooks",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "La suscripción no existe, no está activa o es de otro usuario",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Se pasó del límite de peticiones por IP",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "No hay claves del servicio de identidad con las que verificar el token (AUTH_UNAVAILABLE)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "tags": [
          "Webhooks"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v2/vuelos/webhooks": {
      "get": {
        "operationId": "listWebhooks",
        "summary": "Listar suscripciones de webhooks del partner",
        "description": "Las suscripciones v2 activas del dueño del token (las de /flights/v1/webhooks no aparecen). El secreto no se devuelve (writeOnly).",
        "parameters": [
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "description": "Id del proceso de negocio (máx. 100, [A-Za-z0-9._:-]). Se devuelve sin cambios; si falta, se genera",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Suscripciones activas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WebhookV2Dto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Falta el token, no es válido o venció (UNAUTHORIZED)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsV2"
                }
              }
            }
          },
          "403": {
            "description": "Al token le falta el scope (FORBIDDEN)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsV2"
                }
              }
            }
          },
          "429": {
            "description": "Se pasó del límite de peticiones por IP (RATE_LIMIT_EXCEEDED)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsV2"
                }
              }
            }
          },
          "503": {
            "description": "No hay claves del servicio de identidad con las que verificar el token (PROVIDER_UNAVAILABLE)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsV2"
                }
              }
            }
          }
        },
        "tags": [
          "MS.Clientes — Webhooks (v2)"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "operationId": "createWebhook",
        "summary": "Registrar un webhook para recibir eventos CloudEvents",
        "description": "A lo sumo 10 suscripciones activas por dueño (sumando v1 y v2). Cada entrega es un POST application/cloudevents+json (modo estructurado) con X-Webhook-Signature: sha256=<HMAC-SHA256 en hex del cuerpo con el secreto> y X-Correlation-Id. Reintentos a 1, 5, 30, 120 y 360 minutos hasta un 2xx; lo que no llegue sigue en GET /api/v2/vuelos/eventos.",
        "parameters": [
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "description": "Id del proceso de negocio (máx. 100, [A-Za-z0-9._:-]). Se devuelve sin cambios; si falta, se genera",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Opcional y sin efecto: la operación ya es idempotente por construcción (la misma URL activa del mismo dueño es 409)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolicitudWebhookV2Dto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Webhook registrado (sin el secreto: es writeOnly)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookV2Dto"
                }
              }
            }
          },
          "400": {
            "description": "Cuerpo inválido o URL que no es un destino permitido (VALIDATION_FAILED)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsV2"
                }
              }
            }
          },
          "401": {
            "description": "Falta el token, no es válido o venció (UNAUTHORIZED)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsV2"
                }
              }
            }
          },
          "403": {
            "description": "Al token le falta el scope (FORBIDDEN)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsV2"
                }
              }
            }
          },
          "409": {
            "description": "Ya tiene 10 suscripciones activas o esa URL activa (VALIDATION_FAILED)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsV2"
                }
              }
            }
          },
          "429": {
            "description": "Más de 10 altas por IP en un minuto",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsV2"
                }
              }
            }
          },
          "503": {
            "description": "No hay claves del servicio de identidad con las que verificar el token (PROVIDER_UNAVAILABLE)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsV2"
                }
              }
            }
          }
        },
        "tags": [
          "MS.Clientes — Webhooks (v2)"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
