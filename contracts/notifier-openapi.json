      "SolicitudWebhookV2Dto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "example": "https://rda1-backend-integracion-sistemas.onrender.com/api/v2/webhooks/vuelos",
            "format": "uri",
            "description": "https en producción; con NODE_ENV distinto de production también http://localhost. No se aceptan destinos que resuelvan a redes privadas, loopback, link-local o metadata"
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "example": [
              "booking.confirmed",
              "booking.ticket_issued",
              "flight.status_changed"
            ],
            "items": {
              "$ref": "#/components/schemas/VuelosEventName"
            }
          },
          "secret": {
            "type": "string",
            "minLength": 16,
            "example": "un-secreto-compartido-largo",
            "description": "Con él se firma cada entrega (X-Webhook-Signature: sha256=<HMAC-SHA256 del cuerpo>). Se guarda cifrado y nunca se devuelve: las respuestas traen **** y sus últimos 4 caracteres"
          }
        },
        "required": [
          "url",
          "events",
          "secret"
        ]
      },
      "SobreEventoDto": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid",
            "description": "Id del hecho; la clave de idempotencia"
          },
          "eventType": {
            "type": "string",
            "enum": [
              "hold.created",
              "hold.expired",
              "booking.confirmed",
              "booking.failed",
              "booking.changed",
              "booking.cancelled",
              "booking.baggage_added",
              "booking.seat_changed",
              "booking.ticket_issuing",
              "booking.ticket_issued",
              "booking.ticket_failed",
              "booking.checked_in",
              "flight.status_changed",
              "flight.schedule_changed",
              "flight.cancelled"
            ],
            "example": "booking.confirmed"
          },
          "schemaVersion": {
            "type": "string",
            "example": "1.0",
            "pattern": "^[1-9][0-9]{0,2}\\.[0-9]{1,3}$",
            "description": "mayor.menor; el mayor elige contracts/events/<tipo>.v<mayor>.json"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-16T14:30:00.000Z",
            "description": "Cuándo pasó el hecho, en UTC (sufijo Z)"
          },
          "ownerId": {
            "type": "string",
            "format": "uuid",
            "description": "Dueño del hecho (sub del token que creó el recurso): solo sus suscripciones lo reciben"
          },
          "correlationId": {
            "type": "string",
            "example": "corr-vuelos-7f3a9c",
            "pattern": "^[A-Za-z0-9._:-]{1,100}$",
            "description": "X-Correlation-Id del proceso que originó el hecho, sin cambios (desde 1.1, aceptado en cualquier 1.x). Va al CloudEvent (correlationid) y a la cabecera de cada entrega. Sin él, el de la cabecera X-Correlation-Id de esta publicación (o uno generado)"
          },
          "data": {
            "type": "object",
            "additionalProperties": true,
            "example": {
              "bookingId": "3f0c6a9e-2b1d-4c8e-9a7f-5d4e3c2b1a09",
              "pnr": "Q7K2MX",
              "status": "CONFIRMED"
            },
            "description": "Lo propio de cada tipo (docs/EVENTOS.md); sin campos de más"
          }
        },
        "required": [
          "eventId",
          "eventType",
          "schemaVersion",
          "occurredAt",
          "ownerId",
          "data"
        ]
      },
      "EventoAceptadoDto": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "deliveries": {
            "type": "number",
            "example": 2,
            "description": "Entregas del evento: una por suscripción activa del dueño que escucha el tipo"
          },
          "duplicate": {
            "type": "boolean",
            "example": false,
            "description": "true si el eventId ya se había publicado (200)"
          }
        },
        "required": [
          "eventId",
          "deliveries",
          "duplicate"
        ]
      },
      "CloudEventDto": {
        "type": "object",
        "properties": {
          "specversion": {
            "type": "string",
            "enum": [
              "1.0"
            ]
          },
          "type": {
            "type": "string",
            "example": "ec.edu.epn.booking.vuelos.booking.confirmed"
          },
          "source": {
            "type": "string",
            "example": "/aerolineas/quinde/vuelos"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "El eventId: el mismo que llegó por webhook"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "subject": {
            "type": "string",
            "description": "bookingId, holdId o <flightNumber>/<date>"
          },
          "datacontenttype": {
            "type": "string",
            "enum": [
              "application/json"
            ]
          },
          "correlationid": {
            "type": "string",
            "example": "corr-vuelos-7f3a9c"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "specversion",
          "type",
          "source",
          "id",
          "time",
          "subject",
          "datacontenttype",
          "correlationid",
          "data"
        ]
      },
      "MetadatosFeedDto": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number",
            "example": 1,
            "description": "Eventos en esta página"
          },
          "next_after": {
            "type": "string",
            "nullable": true,
            "format": "uuid",
            "description": "El id del último evento de la página (para pedir la siguiente con `after`); null si la página vino vacía"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "total",
          "next_after",
          "timestamp"
        ]
      },
      "FeedEventosDto": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CloudEventDto"
            }
          },
          "metadata": {
            "$ref": "#/components/schemas/MetadatosFeedDto"
          }
        },
        "required": [
          "events",
          "metadata"
        ]
      }
    }
  }
